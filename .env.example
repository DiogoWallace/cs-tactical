# ---------------------------------------------------------------
# Variáveis do Docker Compose (infraestrutura local).
# Copie para .env com `make setup`. Nunca versione o .env.
# Variáveis de cada aplicação ficam em apps/api/.env e apps/web/.env.
# ---------------------------------------------------------------

# Usuário do WSL que será dono dos arquivos criados pelos containers.
# `make setup` preenche automaticamente com `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# Portas publicadas em 127.0.0.1. Altere se houver conflito com outros projetos.
WEB_PORT=3000
API_PORT=8000
MAILPIT_UI_PORT=8025

# PostgreSQL (somente desenvolvimento local; não publicado no host por padrão).
POSTGRES_DB=cs_tactical
POSTGRES_USER=cs_tactical
POSTGRES_PASSWORD=cs_tactical_dev
