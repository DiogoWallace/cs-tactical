# MODELO de variáveis da API em produção (bloqueios P3 e P4). Não contém segredos: valores
# marcados com <...> vêm do gerenciador de segredos do ambiente, nunca do repositório.
# Conferir no ambiente com: php artisan system:check-production-config
# docs/deploy/bloqueios-de-producao.md

APP_NAME="CS Tactical"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<gerada no ambiente: php artisan key:generate --show>
APP_URL=https://cstactical.example
FRONTEND_URL=https://cstactical.example
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=<host privado do PostgreSQL>
DB_PORT=5432
DB_DATABASE=cs_tactical
DB_USERNAME=<usuário com privilégios mínimos>
DB_PASSWORD=<segredo>

REDIS_HOST=<host privado do Redis>
REDIS_PASSWORD=<segredo>

SESSION_DRIVER=redis
SESSION_COOKIE=cs_tactical_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Só o domínio público, sem localhost.
SANCTUM_STATEFUL_DOMAINS=cstactical.example

# P3: só os IPs da borda (e do Next.js, se ele chamar a API). Nunca uma faixa ampla.
TRUSTED_PROXIES=<IP privado da borda>

HEALTH_EXPOSE_DETAILS=false

QUEUE_CONNECTION=redis

MAIL_MAILER=smtp
MAIL_HOST=<servidor SMTP>
MAIL_PORT=587
MAIL_USERNAME=<segredo>
MAIL_PASSWORD=<segredo>
MAIL_FROM_ADDRESS=nao-responda@cstactical.example
MAIL_FROM_NAME="${APP_NAME}"
