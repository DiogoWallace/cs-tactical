# ---------------------------------------------------------------
# Variáveis da API Laravel. Copiado para apps/api/.env pelo `make setup`.
# Conexões de banco, Redis e e-mail são definidas pelo compose.yaml
# (a partir do .env da raiz) e têm prioridade sobre este arquivo.
# ---------------------------------------------------------------
APP_NAME="CS Tactical"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL pública do frontend (usada em e-mails, CORS e Sanctum).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs vão para o stderr do container (veja com `make logs s=api`).
LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD: definidos no compose.yaml

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=cs_tactical_cache_

REDIS_CLIENT=phpredis
# REDIS_HOST e REDIS_PORT: definidos no compose.yaml

MAIL_MAILER=smtp
# MAIL_HOST e MAIL_PORT: definidos no compose.yaml (Mailpit)
MAIL_FROM_ADDRESS="no-reply@cstactical.local"
MAIL_FROM_NAME="${APP_NAME}"
