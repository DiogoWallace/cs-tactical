{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cs-tactical/api",
    "type": "project",
    "description": "CS Tactical API (Laravel modular monolith).",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "@php -d pcov.enabled=1 vendor/bin/pest --coverage-text --coverage-html=build/coverage --coverage-clover=build/coverage/clover.xml"
        ],
        "test:concurrency": [
            "@php artisan config:clear --ansi",
            "pest tests/Concurrency --group=concurrency"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "pint --test",
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "fmt": [
            "pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.26"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
