<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- No container, o compose injeta variáveis reais de ambiente, que o Laravel lê
             primeiro de $_SERVER. Por isso os valores de teste também são definidos como <server>. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="cs_tactical_test" force="true"/>
        <server name="REDIS_DB" value="1" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <!-- Os testes definem os proxies confiáveis explicitamente (tests/Feature/Http/TrustedProxiesTest.php). -->
        <server name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Testes usam PostgreSQL (paridade com produção), no banco separado cs_tactical_test.
             force="true" sobrescreve o DB_DATABASE definido pelo compose.yaml. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="cs_tactical_test" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="REDIS_DB" value="1" force="true"/>
        <env name="HEALTH_EXPOSE_DETAILS" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
