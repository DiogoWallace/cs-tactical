# ---------------------------------------------------------------
# Variáveis do frontend Next.js. Copiado para apps/web/.env pelo `make setup`.
# Variáveis NEXT_PUBLIC_* vão para o navegador: nunca coloque segredos nelas.
# API_INTERNAL_URL é definida no compose.yaml (rede interna do Docker).
# ---------------------------------------------------------------

# URL pública do frontend (usada como Origin nas chamadas do servidor para a API).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paliativo caso o hot reload não funcione (ex.: repositório fora do ext4 do WSL).
# WATCHPACK_POLLING=true
